{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext", "webworker.importscripts"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@lumen/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "tests/**/*.ts", "tests/**/*.tsx", "benches/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
